# PostmarketOS fixes for mach-msm
# Include this file from the main Makefile

# Relax compiler warnings that are treated as errors
KBUILD_CFLAGS += -Wno-error=array-bounds
KBUILD_CFLAGS += -Wno-error=stringop-overflow
KBUILD_CFLAGS += -Wno-array-bounds
KBUILD_CFLAGS += -Wno-stringop-overflow
KBUILD_CFLAGS += -Wno-error

# Remove any existing -Werror flags
KBUILD_CFLAGS := $(filter-out -Werror, $(KBUILD_CFLAGS))
EXTRA_CFLAGS := $(filter-out -Werror, $(EXTRA_CFLAGS))
